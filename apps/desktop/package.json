{
  "name": "duewise-desktop",
  "version": "0.1.1",
  "private": true,
  "type": "module",
  "description": "Duewise payment tracking and monthly reminder desktop application",
  "main": "electron/main.cjs",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "desktop": "electron .",
    "build": "tsc --noEmit && vite build",
    "package:linux": "npm run build && electron-builder --linux AppImage deb --x64 --publish never",
    "package:win": "npm run build && electron-builder --win nsis --x64 --publish never",
    "package:mac": "npm run build && electron-builder --mac dmg --publish never",
    "test:e2e": "node ../../tests/e2e/desktop.cjs"
  },
  "build": {
    "appId": "com.duewise.desktop",
    "productName": "Duewise",
    "files": [
      "dist/**/*",
      "electron/**/*",
      "package.json",
      "build/icon.png",
      "!node_modules/**",
      "build/icon.ico"
    ],
    "directories": {
      "output": "release"
    },
    "asar": true,
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "build/icon.ico",
      "artifactName": "Duewise-${version}-Windows-${arch}-Setup.${ext}"
    },
    "linux": {
      "target": [
        {
          "target": "AppImage",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "deb",
          "arch": [
            "x64"
          ]
        }
      ],
      "category": "Office",
      "icon": "build/icon.png",
      "syncDesktopName": true,
      "artifactName": "Duewise-${version}-Ubuntu-${arch}.${ext}",
      "maintainer": "Duewise maintainers <299376141+iprabhatmishra25@users.noreply.github.com>"
    },
    "mac": {
      "target": "dmg",
      "hardenedRuntime": true
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "runAfterFinish": false,
      "shortcutName": "Duewise"
    }
  },
  "dependencies": {
    "lucide-react": "1.64.0",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "recharts": "3.10.1"
  },
  "devDependencies": {
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.2",
    "electron": "45.1.0",
    "electron-builder": "26.18.0",
    "playwright": "1.64.1",
    "typescript": "7.0.2",
    "vite": "8.3.5"
  },
  "author": "Duewise",
  "desktopName": "Duewise.desktop",
  "license": "MIT",
  "homepage": "https://github.com/iprabhatmishra25/Payment-Reminder-App#readme",
  "repository": {
    "type": "git",
    "url": "https://github.com/iprabhatmishra25/Payment-Reminder-App.git"
  }
}

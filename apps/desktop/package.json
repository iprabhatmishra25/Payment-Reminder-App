{
  "name": "duewise-desktop",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Duewise payment tracking and monthly reminder desktop application",
  "main": "electron/main.cjs",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "desktop": "electron .",
    "build": "tsc --noEmit && vite build",
    "package:linux": "npm run build && electron-builder --linux AppImage",
    "package:win": "npm run build && electron-builder --win nsis",
    "package:mac": "npm run build && electron-builder --mac dmg",
    "test:e2e": "node ../../tests/e2e/desktop.cjs"
  },
  "build": {
    "appId": "com.duewise.desktop",
    "productName": "Duewise",
    "files": [
      "dist/**/*",
      "electron/**/*",
      "package.json",
      "build/icon.png",
      "!node_modules/**"
    ],
    "directories": {
      "output": "release"
    },
    "asar": true,
    "win": {
      "target": "nsis"
    },
    "linux": {
      "target": [
        "AppImage"
      ],
      "category": "Office",
      "icon": "build/icon.png",
      "syncDesktopName": true
    },
    "mac": {
      "target": "dmg",
      "hardenedRuntime": true
    }
  },
  "dependencies": {
    "lucide-react": "1.64.0",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "recharts": "3.10.1"
  },
  "devDependencies": {
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.2",
    "electron": "45.1.0",
    "electron-builder": "26.18.0",
    "playwright": "1.64.1",
    "typescript": "7.0.2",
    "vite": "8.3.5"
  },
  "author": "Duewise",
  "desktopName": "Duewise.desktop"
}

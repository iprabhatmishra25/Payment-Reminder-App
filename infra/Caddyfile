{$PUBLIC_HOST} {
    encode zstd gzip
    request_body {
        max_size 2MB
    }
    reverse_proxy api:8000 {
        header_up -X-Forwarded-For
        header_up -X-Forwarded-Proto
    }
    header {
        Strict-Transport-Security "max-age=31536000"
        X-Content-Type-Options "nosniff"
        Referrer-Policy "no-referrer"
        -Server
    }
}
